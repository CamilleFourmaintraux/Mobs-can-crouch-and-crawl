			"net.grotacam.mobscrouchandcrawl.MobsCrouchAndCrawl"
		],
		"modmenu": [
			"net.grotacam.mobscrouchandcrawl.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"mobscrouchandcrawl.mixins.json",
		{
			"config": "mobscrouchandcrawl.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "1.21.11",
		"java": ">=21"
	},
	"suggests": {
